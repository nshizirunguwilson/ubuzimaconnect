PORT=4000
DATABASE_URL=
WEB_URL=http://localhost:3000
NIDA_URL=http://localhost:4100
NIDA_API_KEY=
APP_SECRET=
RESEND_API_KEY=
MAIL_FROM=UbuzimaConnect <noreply@ubuzima.wilsonn.tech>
COOKIE_DOMAIN=
# Gemini (FR 4.3). Without a key every case takes the "AI unavailable" path (FR 4.7).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=MINIMAL

# Web Push. Generate a pair once with: npx web-push generate-vapid-keys
# Without them the app works, but sends no push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
