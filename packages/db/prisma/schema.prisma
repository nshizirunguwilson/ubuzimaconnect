// UbuzimaConnect database. Phase 0: identity, staff accounts, sessions and audit.
// Every primary key is a UUID v7 (time-ordered). The national ID is never a key:
// it is stored only as a keyed hash for lookup (NFR 4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------- Places ----------

/// Glossary "Service": the fixed list of care types. Also used as a clinician's specialty.
enum Service {
  EMERGENCY_CARE
  GENERAL_MEDICINE
  INTERNAL_MEDICINE
  PAEDIATRICS
  MATERNITY
  SURGERY
  MENTAL_HEALTH
}

/// Rwanda's levels of care, lowest to highest (DECISIONS.md D21).
enum FacilityLevel {
  HEALTH_POST
  HEALTH_CENTRE
  DISTRICT_HOSPITAL
  PROVINCIAL_HOSPITAL
  REFERRAL_HOSPITAL
}

/// FR 8.1, 8.3, 12.1: the capability profile used for routing.
model Facility {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  level     FacilityLevel
  services  Service[]     @default([])
  province  String
  district  String
  sector    String?
  latitude  Float
  longitude Float
  phone     String?
  /// FR 8.3: available beds = total minus occupied and reserved
  totalBeds Int           @default(0)
  /// FR 8.1: an inactive facility is never used for routing
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  staff    Staff[]
  routings Routing[]
}

// ---------- Patients (FR 1) ----------

model Patient {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// HMAC-SHA256 of the national ID with a server secret. Children without an ID have none.
  nidHash     String?   @unique
  /// Reference used by the identity service for people without their own ID (children).
  nidaRef     String    @unique
  fullName    String
  firstName   String
  dateOfBirth DateTime  @db.Date
  sex         Sex
  district    String?
  /// FR 1.10: served by the identity service; shown to agents to confirm who they talk to.
  photoUrl    String?
  /// NFR 7: "en" or "rw", from the language switch; red-flag questions and notifications follow it
  lang        String    @default("en")
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  /// FR 1.3: a parent can act for their children.
  dependants    FamilyLink[]   @relation("guardian")
  guardians     FamilyLink[]   @relation("dependant")
  sessions      Session[]
  cases         Case[]         @relation("caseFor")
  casesOpened   Case[]         @relation("caseOpenedBy")
  prescriptions Prescription[]
}

enum Sex {
  FEMALE
  MALE
}

model FamilyLink {
  guardianId  String         @db.Uuid
  dependantId String         @db.Uuid
  relation    FamilyRelation
  guardian    Patient        @relation("guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  dependant   Patient        @relation("dependant", fields: [dependantId], references: [id], onDelete: Cascade)

  @@id([guardianId, dependantId])
}

enum FamilyRelation {
  CHILD
}

/// FR 1.6 and 2.3: failed login counts by a key (hashed national ID, or a staff email),
/// kept even when no account exists so guessing IDs is slowed down the same way.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  /// How many temporary locks in a row (FR 2.4: the second one needs an email code).
  locks       Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

// ---------- Staff (FR 2) ----------

enum StaffRole {
  AGENT
  CLINICIAN
  FACILITY_MANAGER
  ADMIN
}

enum StaffStatus {
  /// Invited, no password yet (FR 2.6)
  INVITED
  ACTIVE
  /// FR 2.4: locked a second time; only an emailed unlock code opens it
  LOCKED_EMAIL
  /// Never deleted, kept for the logs
  DEACTIVATED
}

model Staff {
  id               String      @id @default(uuid(7)) @db.Uuid
  email            String      @unique
  name             String
  role             StaffRole
  status           StaffStatus @default(INVITED)
  passwordHash     String?
  /// Agents and clinicians (FR 11.2, 12.1)
  licenceNumber    String?
  /// Clinicians only: exactly one specialty (FR 8.2, glossary)
  specialty        Service?
  /// Agents only (FR 6.1). Busy is set by the system.
  agentStatus      AgentStatus @default(OFFLINE)
  agentStatusSince DateTime    @default(now())
  /// The live connection's last sign of life; 60 s of silence means Offline (FR 6.14)
  lastSeenAt       DateTime?
  facilityId       String?     @db.Uuid
  facility         Facility?   @relation(fields: [facilityId], references: [id])
  invitedById      String?     @db.Uuid
  createdAt        DateTime    @default(now())
  lastLoginAt      DateTime?

  sessions  Session[]
  codes     EmailCode[]
  tokens    StaffToken[]
  shifts    ShiftAssignment[] @relation("shifts")
  handling  Case[]            @relation("agentCases")
  offers    Case[]            @relation("offeredTo")
  messages  ChatMessage[]
  calls     CallNote[]
  attending Routing[]         @relation("attending")
  entries   ClinicalEntry[]
  issues    ArrivalIssue[]
  notices   Notification[]
  issued    Prescription[]
}

enum AgentStatus {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

// ---------- Schedules (FR 8.4, 8.5, 12.4) ----------

/// Day 07:00 to 19:00, Night 19:00 to 07:00 (Africa/Kigali).
enum ShiftType {
  DAY
  NIGHT
}

/// One Day or Night shift for one agent or clinician. A week of these is the weekly schedule.
/// A night shift belongs to the date it starts on.
model ShiftAssignment {
  id                String    @id @default(uuid(7)) @db.Uuid
  staffId           String    @db.Uuid
  staff             Staff     @relation("shifts", fields: [staffId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  shift             ShiftType
  /// FR 8.5: the clinician marked themselves unavailable for this shift
  unavailable       Boolean   @default(false)
  unavailableReason String?
  createdById       String    @db.Uuid
  createdAt         DateTime  @default(now())

  @@unique([staffId, date, shift])
  @@index([date, shift])
}

// ---------- Red flags and settings (FR 3.6, 4.8, 12.6, Appendix C) ----------

/// Appendix C groups: A everyone, C children under 12, N babies under 2 months, P pregnancy.
enum RedFlagGroup {
  A
  C
  N
  P
}

model RedFlagQuestion {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// e.g. "A1"
  code      String       @unique
  group     RedFlagGroup
  textEn    String
  /// Kinyarwanda, entered by the administrator (NFR 7)
  textRw    String?
  service   Service
  source    String?
  sortOrder Int
  /// Removed questions are kept so old cases still show what was asked
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// A single row (id 1): the AI switch and the AI failure counter (FR 4.7, 4.8).
model SystemSettings {
  id             Int       @id @default(1)
  aiEnabled      Boolean   @default(true)
  aiFailureCount Int       @default(0)
  /// FR 6.13: since when no agent has been online; the administrator is alerted after 5 minutes
  noAgentSince   DateTime?
  noAgentAlerted Boolean   @default(false)
  updatedById    String?   @db.Uuid
  updatedAt      DateTime  @updatedAt
}

enum CodePurpose {
  LOGIN
  UNLOCK
}

/// FR 2.2 and 2.4: six-digit codes sent by email. Only a hash is stored.
model EmailCode {
  id        String      @id @default(uuid(7)) @db.Uuid
  staffId   String      @db.Uuid
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  purpose   CodePurpose
  codeHash  String
  tries     Int         @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([staffId, purpose])
}

enum TokenPurpose {
  INVITATION
  PASSWORD_RESET
}

/// FR 2.6 and 2.7: single-use links. Only a hash of the token is stored.
model StaffToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  staffId   String       @db.Uuid
  staff     Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

// ---------- Sessions ----------

/// A login. The cookie holds a random token; only its hash is stored, so a database
/// leak does not leak sessions. Sliding expiry: 15 minutes after the last request (FR 1.7, 2.5).
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  tokenHash    String    @unique
  patientId    String?   @db.Uuid
  patient      Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId      String?   @db.Uuid
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Staff sessions start as pending until the email code is entered (FR 2.2)
  verified     Boolean   @default(false)
  sharedDevice Boolean   @default(false)
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([patientId])
  @@index([staffId])
}

// ---------- Email and audit ----------

/// Every email the system sends. In development this is the outbox you read instead of an inbox.
model EmailMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  to        String
  subject   String
  text      String
  provider  String
  createdAt DateTime @default(now())
}

/// NFR 9: who did what, when. Never updated or deleted.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorType String
  actorId   String?
  action    String
  detail    Json?
  ip        String?
  /// FR 10.2: the patient whose record this event touched, so their activity list is one indexed query
  patientId String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@index([action, createdAt])
  @@index([patientId, createdAt])
}

// ---------- Cases (FR 3, 4) ----------

/// FR 4.4: the priority of a case.
enum TriageLevel {
  URGENT
  UNCERTAIN
  MINOR
}

/// SRS state machine (Figure 7): Submitted → Queued → Offered → Assigned → Closed.
enum CaseStatus {
  SUBMITTED
  QUEUED
  OFFERED
  ASSIGNED
  CLOSED
}

/// FR 6.15, 3.11
enum CaseOutcome {
  ADVISED_REMOTELY
  PRESCRIPTION_ISSUED
  ROUTED_TO_FACILITY
  REFERRED_TO_912
  NO_RESPONSE
  CANCELLED_BY_PATIENT
}

/// SRS §3.3: the AI's fixed category list.
enum Category {
  RESPIRATORY
  FEVER_OR_INFECTION
  DIGESTIVE
  SKIN
  URINARY
  INJURY
  BURN
  PREGNANCY
  CHEST_PAIN_OR_HEART
  NEUROLOGICAL
  MENTAL_HEALTH
  OTHER
}

enum Urgency {
  URGENT
  MINOR
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

enum LocationSource {
  GPS
  MANUAL
}

/// FR 3.7: how long it has lasted.
enum SymptomDuration {
  TODAY
  ONE_TO_THREE_DAYS
  FOUR_TO_SEVEN_DAYS
  MORE_THAN_A_WEEK
}

/// FR 3.8: whose number the agent will call.
enum PhoneOwner {
  MINE
  FAMILY_MEMBER
  SOMEONE_ELSE
}

/// One request for help about one person, from start to closing (FR 3.1 to 3.11, 6.15).
model Case {
  id              String           @id @default(uuid(7)) @db.Uuid
  /// Human code shown to people, e.g. UC-20261024-0042
  code            String           @unique
  /// The sick person (the patient, or one of their children)
  patientId       String           @db.Uuid
  patient         Patient          @relation("caseFor", fields: [patientId], references: [id])
  /// Who opened it (a parent opening for a child)
  openedById      String           @db.Uuid
  openedBy        Patient          @relation("caseOpenedBy", fields: [openedById], references: [id])
  status          CaseStatus       @default(SUBMITTED)
  triageLevel     TriageLevel?
  /// Why the level was set, in words (red flag, newborn rule, AI result or the uncertainty rule)
  triageReason    String?
  category        Category?
  neededService   Service?
  bedNeeded       Boolean?
  /// FR 3.6: the answer to "Are you pregnant?", when asked
  pregnant        Boolean?
  /// Empty only for a "Prefer a call" request made from the home screen (FR 3.8)
  latitude        Float?
  longitude       Float?
  locationSource  LocationSource?
  sectorCode      String?
  description     String?
  duration        SymptomDuration?
  /// 1 to 10
  severity        Int?
  /// FR 3.8, 3.9: the number is kept for this case only
  callRequested   Boolean          @default(false)
  callNumber      String?
  callNumberOwner PhoneOwner?
  /// FR 6.3, 6.4: the agent the case is offered to, and the one handling it
  offeredToId     String?          @db.Uuid
  offeredTo       Staff?           @relation("offeredTo", fields: [offeredToId], references: [id])
  offerExpiresAt  DateTime?
  /// Agents who let this offer pass, so it goes to the next one (FR 6.3)
  offerSkipped    String[]         @default([]) @db.Uuid
  agentId         String?          @db.Uuid
  agent           Staff?           @relation("agentCases", fields: [agentId], references: [id])
  assignedAt      DateTime?
  /// FR 6.12, 6.14, 6.16: back to the front of its queue level
  frontOfQueue    Boolean          @default(false)
  /// FR 6.10, 6.11: 0 none, 1 after 2 minutes unaccepted, 2 after 5 minutes (a delay incident)
  escalationLevel Int              @default(0)
  /// When the last escalation alert went out; they repeat every 2 minutes at level 2
  escalatedAt     DateTime?
  outcome         CaseOutcome?
  closingNote     String?
  rating          Int?
  createdAt       DateTime         @default(now())
  queuedAt        DateTime?
  closedAt        DateTime?

  answers       RedFlagAnswer[]
  aiResult      AIResult?
  messages      ChatMessage[]
  calls         CallNote[]
  changes       CaseChange[]
  routings      Routing[]
  prescriptions Prescription[]

  @@index([patientId, status])
  @@index([status, triageLevel, queuedAt])
}

/// The Yes or No answer to one question. The question text is copied, so later edits
/// to the list never change what this case was asked (FR 12.6).
model RedFlagAnswer {
  id         String   @id @default(uuid(7)) @db.Uuid
  caseId     String   @db.Uuid
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  questionId String   @db.Uuid
  code       String
  textEn     String
  answer     Boolean
  createdAt  DateTime @default(now())

  @@unique([caseId, questionId])
}

/// FR 4.3 to 4.7: what the AI returned, or why it didn't.
model AIResult {
  id         String      @id @default(uuid(7)) @db.Uuid
  caseId     String      @unique @db.Uuid
  case       Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category   Category?
  urgency    Urgency?
  confidence Confidence?
  reason     String?
  /// Set when the AI failed, timed out, was skipped or switched off
  error      String?
  latencyMs  Int?
  createdAt  DateTime    @default(now())
}

// ---------- Handling a case (FR 6) ----------

enum MessageSender {
  PATIENT
  AGENT
  SYSTEM
}

/// FR 6.6: chat between the patient and the agent, saved with the case.
model ChatMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  caseId    String        @db.Uuid
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender    MessageSender
  staffId   String?       @db.Uuid
  staff     Staff?        @relation(fields: [staffId], references: [id])
  text      String
  createdAt DateTime      @default(now())

  @@index([caseId, createdAt])
}

/// FR 6.7: one call attempt and its note.
model CallNote {
  id           String   @id @default(uuid(7)) @db.Uuid
  caseId       String   @db.Uuid
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staffId      String   @db.Uuid
  staff        Staff    @relation(fields: [staffId], references: [id])
  answered     Boolean
  /// When the number isn't the patient's own, the date of birth was confirmed first
  dobConfirmed Boolean  @default(false)
  note         String
  createdAt    DateTime @default(now())

  @@index([caseId, createdAt])
}

/// FR 6.5: every change to the triage, with who made it and when.
model CaseChange {
  id        String   @id @default(uuid(7)) @db.Uuid
  caseId    String   @db.Uuid
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staffId   String   @db.Uuid
  field     String
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
}

// ---------- Routing (FR 5) ----------

/// SRS state machine (Figure 9), plus Cancelled when the patient cancels the case.
enum RoutingStatus {
  SUGGESTED
  CONFIRMED
  CHANGED
  EXPIRED
  CANCELLED
  ARRIVED
  DISCHARGED
  COMPLETED
  TRANSFERRED
}

/// A facility and attending clinician for a case. Confirmed routings are valid 24 hours (FR 5.6).
model Routing {
  id              String        @id @default(uuid(7)) @db.Uuid
  caseId          String        @db.Uuid
  case            Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  facilityId      String        @db.Uuid
  facility        Facility      @relation(fields: [facilityId], references: [id])
  service         Service
  bedNeeded       Boolean
  /// Required when the agent didn't choose the nearest (FR 5.6)
  reason          String?
  clinicianId     String?       @db.Uuid
  clinician       Staff?        @relation("attending", fields: [clinicianId], references: [id])
  /// Required when the clinician's specialty differs (FR 5.12)
  clinicianReason String?
  status          RoutingStatus
  distanceKm      Float?
  createdById     String?       @db.Uuid
  confirmedAt     DateTime?
  expiresAt       DateTime?
  endedAt         DateTime?
  /// FR 7.5: the patient arrived; the routing is now the active visit until it ends (DECISIONS.md D39)
  arrivedAt       DateTime?
  arrivedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())

  reservation   BedReservation?
  entries       ClinicalEntry[]
  issues        ArrivalIssue[]
  notices       Notification[]
  prescriptions Prescription[]

  @@index([facilityId, status])
  @@index([caseId])
}

/// SRS state machine (Figure 10).
enum ReservationStatus {
  HELD
  USED
  RELEASED
}

/// FR 5.7: one bed held from the moment the facility is given to the patient.
model BedReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  routingId     String            @unique @db.Uuid
  routing       Routing           @relation(fields: [routingId], references: [id], onDelete: Cascade)
  facilityId    String            @db.Uuid
  status        ReservationStatus @default(HELD)
  /// Released if the patient hasn't arrived by then (6 hours)
  releaseAfter  DateTime
  releasedAt    DateTime?
  releaseReason String?
  createdAt     DateTime          @default(now())

  @@index([facilityId, status])
}

// ---------- Visits (FR 7) ----------

/// FR 7.7: one version of a record entry. An update adds a new version with the same
/// rootId and keeps the earlier ones. Entries can't change after the visit ends.
model ClinicalEntry {
  id                String   @id @default(uuid(7)) @db.Uuid
  /// The first version's id; shared by every version of this entry
  rootId            String   @db.Uuid
  version           Int      @default(1)
  previousVersionId String?  @unique @db.Uuid
  routingId         String   @db.Uuid
  routing           Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)
  /// Kept so a patient's entries from every facility load in one query (FR 7.3)
  patientId         String   @db.Uuid
  authorId          String   @db.Uuid
  author            Staff    @relation(fields: [authorId], references: [id])
  diagnosis         String?
  treatment         String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([routingId, rootId])
  @@index([patientId, createdAt])
}

/// FR 7.5: the arriving person didn't match the identity photo, so they weren't marked Arrived.
model ArrivalIssue {
  id          String   @id @default(uuid(7)) @db.Uuid
  routingId   String   @db.Uuid
  routing     Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)
  clinicianId String   @db.Uuid
  clinician   Staff    @relation(fields: [clinicianId], references: [id])
  note        String
  createdAt   DateTime @default(now())
}

enum NotificationKind {
  /// FR 5.12: you are the attending clinician for an incoming patient
  INCOMING
  /// FR 7.11: a colleague handed a patient over to you
  HANDOVER
}

/// What a staff member is told. Shown in the app; push notifications come in phase 3.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  staffId   String           @db.Uuid
  staff     Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  routingId String           @db.Uuid
  routing   Routing          @relation(fields: [routingId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([staffId, readAt])
}

// ---------- Prescriptions (FR 11) ----------

/// FR 11.1 to 11.4: issued by the agent during a case or the attending clinician during a visit.
/// Valid at pharmacies for 7 days; kept forever, shown as Expired or Cancelled afterwards.
model Prescription {
  id           String             @id @default(uuid(7)) @db.Uuid
  /// FR 11.2: the code on the prescription and in its QR code, e.g. RX-7K3M-9QPD
  code         String             @unique
  patientId    String             @db.Uuid
  patient      Patient            @relation(fields: [patientId], references: [id])
  /// Exactly one of these: the agent's case or the clinician's visit
  caseId       String?            @db.Uuid
  case         Case?              @relation(fields: [caseId], references: [id])
  routingId    String?            @db.Uuid
  routing      Routing?           @relation(fields: [routingId], references: [id])
  prescriberId String             @db.Uuid
  prescriber   Staff              @relation(fields: [prescriberId], references: [id])
  validUntil   DateTime
  /// FR 11.3: only the prescriber can cancel; it then shows "Do not dispense"
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime           @default(now())
  items        PrescriptionItem[]

  @@index([patientId, createdAt])
  @@index([prescriberId, createdAt])
}

/// One medicine on a prescription (FR 11.1).
model PrescriptionItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  position       Int
  medicine       String
  dose           String
  /// "how often", e.g. 3 times a day
  frequency      String
  days           Int
  instructions   String?
}

// ---------- Alerts (FR 12.7) ----------

enum AlertKind {
  /// FR 6.10: an Urgent or Uncertain case not accepted in 2 minutes
  ESCALATION
  /// FR 6.11: still not accepted after 5 minutes; also emailed
  DELAY_INCIDENT
  /// FR 6.13: no agent online for 5 minutes
  NO_AGENT
  /// FR 5.8, 5.9: no facility, or no free bed, for a case
  NO_CAPACITY
  /// FR 4.7: more than 5 AI failures in 5 minutes
  AI_FAILURES
}

/**
 * What the administrator is told, shown in the app (and emailed for the serious ones).
 */
model Alert {
  id        String    @id @default(uuid(7)) @db.Uuid
  kind      AlertKind
  message   String
  caseId    String?   @db.Uuid
  emailed   Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

// ---------- Push notifications (FR 6.6, 1.8, NFR 13) ----------

/// One browser that agreed to receive notifications, for a patient or a staff member.
/// Never created from a shared device (FR 1.8). Removed when the push service says it is gone.
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// The push service's address for this browser; unique per browser
  endpoint   String    @unique
  p256dh     String
  auth       String
  patientId  String?   @db.Uuid
  staffId    String?   @db.Uuid
  /// phone, tablet or computer: shown to the person, never the full browser details
  device     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([patientId])
  @@index([staffId])
}
